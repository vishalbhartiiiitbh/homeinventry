<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left Pillar Facet 1 (Dark Emerald) -->
    <path
        android:fillColor="#0B523A"
        android:pathData="M32,30 L44,23 L44,65 L32,72 Z" />

    <!-- Left Pillar Facet 2 (Vibrant Green Gradient) -->
    <path
        android:pathData="M32,30 L44,23 L44,38 L32,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="30"
                android:endX="44"
                android:endY="38"
                android:type="linear">
                <item android:color="#2ECC71" android:offset="0.0" />
                <item android:color="#00B894" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Interlocking Ribbon Horizontal Bar (Teal) -->
    <path
        android:pathData="M32,45 L62,28 L74,35 L44,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="45"
                android:endX="74"
                android:endY="35"
                android:type="linear">
                <item android:color="#00E676" android:offset="0.0" />
                <item android:color="#00B0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Pillar Top Facet (Emerald) -->
    <path
        android:pathData="M62,28 L74,21 L74,48 L62,55 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="62"
                android:startY="28"
                android:endX="74"
                android:endY="48"
                android:type="linear">
                <item android:color="#00B894" android:offset="0.0" />
                <item android:color="#00897B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lower Interlocking Loop Ribbon (Deep Teal-Navy Gradient) -->
    <path
        android:pathData="M44,52 L74,35 L74,48 L44,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="52"
                android:endX="74"
                android:endY="48"
                android:type="linear">
                <item android:color="#00897B" android:offset="0.0" />
                <item android:color="#0B3C35" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lower Right Bottom Base Box Shadow (Dark Navy-Teal) -->
    <path
        android:fillColor="#092B25"
        android:pathData="M44,65 L62,55 L74,62 L56,72 Z" />

    <!-- Lower Loop Return Facet (Teal Highlight) -->
    <path
        android:pathData="M44,52 L56,45 L74,55 L62,62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="52"
                android:endX="74"
                android:endY="62"
                android:type="linear">
                <item android:color="#1DE9B6" android:offset="0.0" />
                <item android:color="#00B0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
